# Supabase (create a project at https://supabase.com)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Vercel Edge Functions base URL (for AI features later)
# VITE_AI_API_BASE=https://your-project.vercel.app/api

# Optional: E2E tests (Playwright). Set both to run authenticated vocabulary flows.
# E2E_TEST_EMAIL=test@example.com
# E2E_TEST_PASSWORD=your-test-password
